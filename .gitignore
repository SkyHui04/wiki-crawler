# ==============================
# Backend — Python
# ==============================
# Bytecode & cache
backend/**/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.pyc
backend/.Python
backend/*.so

# Virtual environments (common names)
backend/venv/
backend/.venv/
backend/env/
backend/.env/
backend/ENV/

# Environment & secrets (backend)
backend/.env
backend/.env.local
backend/.env.*.local
backend/*.pem
backend/*.key
backend/credentials.json
backend/service_account.json

# Build / packaging
backend/build/
backend/dist/
backend/*.egg-info/
backend/eggs/
backend/wheels/
backend/*.egg

# Testing & coverage (backend)
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.tox/
backend/.nox/
backend/.mypy_cache/

# Logs
backend/*.log
backend/logs/

# IDE / tooling (backend-specific)
backend/.idea/
backend/.vscode/
backend/*.ipynb_checkpoints

# ==============================
# General / repo-wide
# ==============================
